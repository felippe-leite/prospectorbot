# Loaded automatically from .env in the current working directory.
# Existing environment variables take precedence over this file.
PROSPECTOR_DATABASE_PATH=data/prospector.db
GEOAPIFY_API_KEY=your_geoapify_key_here
# Optional: enables mobile performance measurement (Google PageSpeed Insights).
PAGESPEED_API_KEY=
PROSPECTOR_REQUEST_TIMEOUT=10
PROSPECTOR_REQUEST_INTERVAL=1
PROSPECTOR_MAX_LINKS=5
# Optional JSON config; generate using the README instructions.
# PROSPECTOR_SCORING_CONFIG=data/scoring.json
# Web frontend origins allowed to call the API (comma-separated).
# PROSPECTOR_CORS_ORIGINS=http://localhost:3000
